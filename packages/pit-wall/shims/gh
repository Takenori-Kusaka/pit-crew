    { echo "$1 $NEXT" >> "$_pw_numbers"; } 2>/dev/null || true
    echo "https://github.com/$repo/$kind/$NEXT" ;;
  "issue view") fixture "issue-$N.md" || echo "#$N: (no body)" ;;
  "pr checks")
    # A cell may give the check results (I-22: a required check skipped). Otherwise all pass.
    fixture "checks-$N.txt" || echo "ci	pass	1m0s" ;;
  "pr ready")   echo "✓ Pull request #$N is marked as \"ready for review\"" ;;
  "pr view")
    if [[ " $* " == *" --json"* ]] && [ -f ".github-cache/pr-$N.json" ]; then
      # Only the requested fields, as gh does (a review grader reads "did it open the checks"
      # from the fields that came back). Without node, the whole fixture is returned.
      flds=; prev=; for a in "$@"; do [ "$prev" = --json ] && flds=$a; case "$a" in --json=*) flds=${a#--json=} ;; esac; prev=$a; done
      if [ -n "$flds" ] && command -v node >/dev/null 2>&1; then
        node -e 'const f=require("fs").readFileSync(process.argv[1],"utf8");const o=JSON.parse(f);const k=process.argv[2].split(",").map(s=>s.trim()).filter(Boolean);const out={};for(const x of k) if(x in o) out[x]=o[x];console.log(JSON.stringify(out))' ".github-cache/pr-$N.json" "$flds" 2>/dev/null || cat ".github-cache/pr-$N.json"
      else cat ".github-cache/pr-$N.json"; fi
    elif [[ " $* " == *" --json"* ]]; then
      echo "{\"number\":$N,\"state\":\"OPEN\",\"isDraft\":false,\"mergeable\":\"MERGEABLE\",\"reviewDecision\":\"REVIEW_REQUIRED\",\"author\":{\"login\":\"you\"},\"statusCheckRollup\":[{\"name\":\"ci\",\"conclusion\":\"SUCCESS\"}]}"
    else
      fixture "pr-$N.md" || echo "#$N opened by you · CI passing · review required"
    fi ;;
  "issue edit")  _pw_reply_ref "$@"; echo "https://github.com/$repo/issues/$N" ;;
  "pr edit")     _pw_reply_ref "$@"; echo "https://github.com/$repo/pull/$N" ;;
  "issue comment"|"pr comment")
    _pw_reply_ref "$@"; _pw_comment_id
    if [ "$1" = pr ]; then kind=pull; else kind=issues; fi
    if [ -n "$REF" ]; then echo "https://github.com/$repo/$kind/$REF#issuecomment-$CID"
    else
      # no number: gh comments on the PR of the current branch — the last PR this session created, when there is one
      REF=$(sed -n 's/^pr \([0-9][0-9]*\)$/\1/p' "$_pw_numbers" 2>/dev/null | tail -n 1)
      if [ "$1" = pr ] && [ -n "$REF" ]; then echo "https://github.com/$repo/pull/$REF#issuecomment-$CID"; else echo "ok"; fi
    fi ;;
  "pr diff")
    # A review cell gives the PR's diff (diff-N.patch); --name-only lists its files.
    if [[ " $* " == *" --name-only "* ]]; then fixture "diff-$N.patch" | sed -n 's|^+++ b/||p'
    else fixture "diff-$N.patch" || echo "(no diff recorded for #$N)"; fi ;;
  "pr review")                  echo "✓ Reviewed pull request #$N" ;;
  "pr merge")                   echo "✓ Merged pull request #$N" ;;
  "auth switch")                echo "✓ Switched active account for github.com" ;;
  "auth status")
    acct=$(sed -n 's/.*"account":"\([^"]*\)".*/\1/p' "${PITWALL_GH_STATE:-/tmp/pitwall-gh-state.json}" 2>/dev/null)
    echo "✓ Logged in to github.com account ${acct:-you} (keyring)" ;;
  *)                            echo "ok" ;;
esac
exit 0
