# --- dependencies / build output ---
node_modules/
*.tsbuildinfo

# --- pit-wall working output (conclusions are moved into runs/<date>/ before commit) ---
pitwall-out/
evals/results/
**/evals/results/

# --- scratch / local state (anchored at the root so fixtures under runs/ and suites/ are not affected) ---
/tmp/
/scratch/
/scratchpad/
/.scratch/
/.dev-state.md
/packages/*/tmp/

# --- local caches ---
.cache/
.npm/
.eslintcache
.pytest_cache/
__pycache__/
*.pyc

# --- large binaries / archives / model weights ---
*.tgz
*.tar.gz
*.zst
*.zip
*.safetensors
*.gguf
*.ckpt
*.pt
*.onnx

# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
oauth-token

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
