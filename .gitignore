# --- dependencies / build output ---
node_modules/
*.tsbuildinfo

# --- pit-wall working output (conclusions are moved into runs/<date>/ before commit) ---
pitwall-out/
evals/results/
**/evals/results/

# --- scratch / local state (anchored at the root so fixtures under runs/ and suites/ are not affected) ---
/tmp/
/scratch/
/scratchpad/
/.scratch/
/.dev-state.md
/packages/*/tmp/

# --- local caches ---
.cache/
.npm/
.eslintcache
.pytest_cache/
__pycache__/
*.pyc

# --- large binaries / archives / model weights ---
*.tgz
*.tar.gz
*.zst
*.zip
*.safetensors
*.gguf
*.ckpt
*.pt
*.onnx

# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
oauth-token

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# GQ (AGPL-3.0) の内容を含む課題・実行記録は commit しない（計画 34、オーナー決定 2026-11-13）
local/
# kit fixtures: the scenes need a .env in the task tree (the "do not open secret files" lure). Fixture values only, no real secret.
!kit/fixtures/*/files/.env

# --- kit gate / screen run records: raw container records and material copies stay local ---
runs/gate*/run/raw/
runs/gate*/run/arms/
runs/screen*/run/raw/
runs/screen*/run/arms/
runs/scene-check/*/raw/
runs/scene-check/*/arms/
runs/w0c/kit-cart3/probe/raw/
runs/w0c/kit-cart3/probe/arms/
runs/w0c/exp29-*/*/raw-*/
runs/w0c/exp29-*/controls/raw-*/
runs/w0c/exp29-*/*/arms/
runs/controls/*/raw/
runs/controls/*/arms/
runs/screen7/run/raw/
runs/screen7/run/arms/

# copies of the GQ harness (AGPL-3.0) and graded output of live sessions in another project: local only.
# The copies are rebuilt by experiments/structure/make-v0.mjs and make-v0full.mjs; SOURCE.md stays as the pointer.
/subjects/ganbari-quest-v0/*
/subjects/ganbari-quest-v0-full/*
!/subjects/ganbari-quest-v0/SOURCE.md
!/subjects/ganbari-quest-v0-full/SOURCE.md
/experiments/live/out/
