diff --git a/src/book.sh b/src/book.sh
index 39cbb62..d3f95b4 100644
--- a/src/book.sh
+++ b/src/book.sh
@@ -3,6 +3,7 @@
 set -u
 . "$(dirname "$0")/lib/slots.sh"
 BOOKINGS=${BOOKINGS:-data/bookings.tsv}
+[ $# -eq 5 ] || { echo "usage: book.sh ROOM DATE START END WHO" >&2; exit 2; }
