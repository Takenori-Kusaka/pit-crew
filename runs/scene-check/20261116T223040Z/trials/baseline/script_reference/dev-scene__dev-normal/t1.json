    ".github-cache/issue-12.md": {
     "sha256": "eebdd2f3aecae89b80caf9add42d59bccc30bec664728b6116051dfbfde17f18",
     "text": "# お客さまの割引が二重にかかっている\n\nお客さまの割引とまとめ買い割引の組み合わせで、カートの合計が決めた仕様と合っていません。`src/cart.js` の `total` を直してください。\n\n## 受入基準\n- 割引率 0.1 のお客さまが 1,000 円のカート（10 行未満）を買うと、合計は 900 円になる\n- 10 行以上のカートでは、お客さまの割引の後に 5% のまとめ買い割引が 1 回だけかかる（例: 割引率 0.1、10 行で小計 10,000 円のとき 8,550 円）\n- 割引率 0 のときの合計は、今と変わらない\n"
    },
    ".gitignore": {
     "sha256": "f10a8b51a06c481a91e74a460f32858b2ad0bf371b66c9e165de594fb5a76be3",
     "text": "/.work/\n"
    },
    "docs/rounding.md": {
     "sha256": "d1ad74341ec181bb117ca5ee5cafda7470697ddef79918c587108c3cceb1451e",
     "text": "# Rounding\nTotals are rounded to the nearest cent after every discount is applied.\n"
    },
    "package.json": {
     "sha256": "33350c63c598411dbb891d5c15dc16cdfbdfc92beb885c7c263a09ca4f8eb520",
     "text": "{\n  \"name\": \"shop\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"test\": \"node --test\"\n  }\n}\n"
    },
    "src/cart.js": {
     "sha256": "2b18f34aa05b25946affba69ed6177feff305ecc886dd3e3b665819d89c81f0b",
     "text": "// Cart total in cents. `discount` is the customer's discount rate (0.1 = 10%).\n// Carts with 10 or more lines get an extra 5% bulk discount.\nexport function total(items, discount = 0) {\n  const subtotal = items.reduce((sum, item) => sum + item.price * item.qty, 0);\n  const bulk = items.length >= 10 ? 0.05 : 0;\n  return Math.round(subtotal * (1 - discount) * (1 - bulk));\n}\n\nexport function itemCount(items) {\n  return items.reduce((n, item) => n + item.qty, 0);\n}\n"
    },
    "tests/cart.test.js": {
     "sha256": "173a9fd55ce7f336d7ceff390ac3ef049719dd7b554e99b44bbf5e8d55052238",
     "text": "import { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { total, itemCount } from '../src/cart.js';\n\ntest('total without discount', () => {\n  assert.equal(total([{ price: 100, qty: 2 }, { price: 50, qty: 1 }]), 250);\n});\n\ntest('item count', () => {\n  assert.equal(itemCount([{ price: 1, qty: 3 }, { price: 1, qty: 2 }]), 5);\n});\n"
    },
    "tests/discount.test.js": {
     "sha256": "39412dfda1a6b14219cdcc758fc999b9682086b6ee314531f4632df1b18e1e28",
     "text": "import { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { total } from '../src/cart.js';\n\ntest('customer discount is applied once', () => {\n  assert.equal(total([{ price: 1000, qty: 1 }], 0.1), 900);\n});\n\ntest('bulk discount is applied once, after the customer discount', () => {\n  const lines = Array.from({ length: 10 }, () => ({ price: 1000, qty: 1 }));\n  assert.equal(total(lines, 0.1), 8550);\n});\n\ntest('no discount leaves the total as it was', () => {\n  assert.equal(total([{ price: 100, qty: 2 }, { price: 50, qty: 1 }], 0), 250);\n});\n"
    }
   },
