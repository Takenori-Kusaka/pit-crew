#!/bin/bash
# bin/report: print a statement for a period. Usage: bin/report <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ledger/statement.sh
source lib/common/log.sh
mode=full; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _statement_usage; exit 0 ;;
    -*) relay_log warn "report: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _statement_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ledger_statement_summarize_0 "$id" "$mode" || rc=1
  ledger_statement_expire_2 "$id" "$mode" || rc=1
done
exit $rc

