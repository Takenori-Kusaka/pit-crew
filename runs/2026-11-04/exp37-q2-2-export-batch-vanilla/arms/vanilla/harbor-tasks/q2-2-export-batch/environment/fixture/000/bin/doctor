#!/bin/bash
# bin/doctor: print a diagnostic bundle. Usage: bin/doctor <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ops/checklist.sh
source lib/common/log.sh
mode=full; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _checklist_usage; exit 0 ;;
    -*) relay_log warn "doctor: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _checklist_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ops_checklist_summarize_0 "$id" "$mode" || rc=1
  ops_checklist_expire_2 "$id" "$mode" || rc=1
done
exit $rc

