#!/bin/bash
# bin/statement: close a period and print the statement. Usage: bin/statement <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ledger/period.sh
source lib/common/log.sh
mode=full; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _period_usage; exit 0 ;;
    -*) relay_log warn "statement: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _period_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ledger_period_score_0 "$id" "$mode" || rc=1
  ledger_period_merge_2 "$id" "$mode" || rc=1
done
exit $rc

