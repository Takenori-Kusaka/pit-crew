#!/bin/bash
# bin/inspect: inspect a parcel. Usage: bin/inspect <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/parcel/scan.sh
source lib/common/log.sh
mode=online; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _scan_usage; exit 0 ;;
    -*) relay_log warn "inspect: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _scan_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  parcel_scan_normalize_0 "$id" "$mode" || rc=1
  parcel_scan_score_2 "$id" "$mode" || rc=1
done
exit $rc

