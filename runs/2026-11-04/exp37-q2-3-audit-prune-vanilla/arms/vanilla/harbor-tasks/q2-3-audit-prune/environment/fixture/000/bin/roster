#!/bin/bash
# bin/roster: manage the roster. Usage: bin/roster <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ops/roster.sh
source lib/common/log.sh
mode=live; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _roster_usage; exit 0 ;;
    -*) relay_log warn "roster: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _roster_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ops_roster_score_0 "$id" "$mode" || rc=1
  ops_roster_merge_2 "$id" "$mode" || rc=1
done
exit $rc

