#!/bin/bash
# bin/incident: open or close an incident. Usage: bin/incident <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ops/incident.sh
source lib/common/log.sh
mode=live; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _incident_usage; exit 0 ;;
    -*) relay_log warn "incident: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _incident_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ops_incident_merge_0 "$id" "$mode" || rc=1
  ops_incident_tag_2 "$id" "$mode" || rc=1
done
exit $rc

