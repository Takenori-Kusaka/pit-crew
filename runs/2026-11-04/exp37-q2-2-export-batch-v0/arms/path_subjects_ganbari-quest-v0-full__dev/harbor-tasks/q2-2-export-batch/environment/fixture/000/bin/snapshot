#!/bin/bash
# bin/snapshot: take or compact a snapshot. Usage: bin/snapshot <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/store/snapshot.sh
source lib/common/log.sh
mode=strict; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _snapshot_usage; exit 0 ;;
    -*) relay_log warn "snapshot: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _snapshot_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  store_snapshot_merge_0 "$id" "$mode" || rc=1
  store_snapshot_tag_2 "$id" "$mode" || rc=1
done
exit $rc

