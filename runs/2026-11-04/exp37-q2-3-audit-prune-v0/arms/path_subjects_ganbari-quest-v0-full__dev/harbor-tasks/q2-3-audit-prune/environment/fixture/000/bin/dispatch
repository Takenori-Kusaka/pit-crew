#!/bin/bash
# bin/dispatch: dispatch a route. Usage: bin/dispatch <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/route/stop.sh
source lib/common/log.sh
mode=strict; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _stop_usage; exit 0 ;;
    -*) relay_log warn "dispatch: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _stop_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  route_stop_normalize_0 "$id" "$mode" || rc=1
  route_stop_score_2 "$id" "$mode" || rc=1
done
exit $rc

