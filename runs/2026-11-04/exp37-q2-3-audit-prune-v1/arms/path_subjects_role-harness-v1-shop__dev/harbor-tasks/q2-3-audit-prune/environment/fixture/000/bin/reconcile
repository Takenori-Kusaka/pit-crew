#!/bin/bash
# bin/reconcile: reconcile with a partner. Usage: bin/reconcile <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/ledger/reconcile.sh
source lib/common/log.sh
mode=live; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _reconcile_usage; exit 0 ;;
    -*) relay_log warn "reconcile: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _reconcile_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  ledger_reconcile_summarize_0 "$id" "$mode" || rc=1
  ledger_reconcile_expire_2 "$id" "$mode" || rc=1
done
exit $rc

