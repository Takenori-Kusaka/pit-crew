#!/bin/bash
# bin/resend: resend a notification. Usage: bin/resend <id>... [--mode m]
cd "$(dirname "$0")/.." || exit 1
source lib/notify/sms.sh
source lib/common/log.sh
mode=full; ids=()
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) mode="$2"; shift 2 ;;
    -h|--help) _sms_usage; exit 0 ;;
    -*) relay_log warn "resend: unknown option $1"; exit 2 ;;
    *) ids+=("$1"); shift ;;
  esac
done
[ "${#ids[@]}" -gt 0 ] || { _sms_usage; exit 2; }
rc=0
for id in "${ids[@]}"; do
  notify_sms_lookup_0 "$id" "$mode" || rc=1
  notify_sms_list_2 "$id" "$mode" || rc=1
done
exit $rc

