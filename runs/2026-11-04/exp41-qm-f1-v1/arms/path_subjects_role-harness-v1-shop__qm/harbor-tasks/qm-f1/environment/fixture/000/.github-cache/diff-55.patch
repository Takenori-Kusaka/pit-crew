diff --git a/spec/slots.spec.sh b/spec/slots.spec.sh
index 6cf96b2..541f655 100644
--- a/spec/slots.spec.sh
+++ b/spec/slots.spec.sh
@@ -5,5 +5,7 @@ overlaps 600 660 630 700 || { echo "overlap: 10:00-11:00 vs 10:30-11:40"; fail=1
 overlaps 600 720 630 650 || { echo "overlap: containment"; fail=1; }
 ! overlaps 600 660 700 760 || { echo "apart: 10:00-11:00 vs 11:40-12:40"; fail=1; }
 [ "$(to_min 09:05)" = 545 ] || { echo "to_min 09:05"; fail=1; }
+! overlaps 600 660 660 720 || { echo "back-to-back: 10:00-11:00 then 11:00-12:00"; fail=1; }
+! overlaps 660 720 600 660 || { echo "back-to-back reversed"; fail=1; }
 exit $fail
 
diff --git a/src/lib/slots.sh b/src/lib/slots.sh
index 073425a..089c604 100644
--- a/src/lib/slots.sh
+++ b/src/lib/slots.sh
@@ -2,5 +2,5 @@
 # Time helpers for bookings. Times are HH:MM (24h); intervals are [start, end).
 to_min() { local h=${1%%:*} m=${1##*:}; echo $(( 10#$h * 60 + 10#$m )); }
 # overlaps S1 E1 S2 E2 (minutes): succeeds when the two bookings share time.
-overlaps() { [ "$1" -le "$4" ] && [ "$3" -le "$2" ]; }
+overlaps() { [ "$1" -lt "$4" ] && [ "$3" -lt "$2" ]; }
 
