diff --git a/spec/purge-archive.spec.sh b/spec/purge-archive.spec.sh
new file mode 100644
index 0000000..1a24c5f
--- /dev/null
+++ b/spec/purge-archive.spec.sh
@@ -0,0 +1,9 @@
+#!/bin/bash
+fail=0
+t=$(mktemp); printf '# h\n2024-06-03\taoi\t09:00\t10:00\tx\n2024-12-31\tkaede\t13:00\t15:00\ty\n2025-01-08\tsakura\t10:00\t11:00\tz\n' > "$t"
+out=$(ARCHIVE=$t bash tools/purge-archive --before 2025-01-01) || { echo "purge --before failed"; fail=1; }
+[ "$out" = "purged 2 row(s) before 2025-01-01 from $t" ] || { echo "purge output: $out"; fail=1; }
+[ "$(grep -vc '^#' "$t")" = 1 ] && grep -q 'z$' "$t" || { echo "purge --before kept the wrong rows"; fail=1; }
+ARCHIVE=$t bash tools/purge-archive --before 2025/06/01 >/dev/null 2>&1; [ $? = 2 ] || { echo "a malformed date should exit 2"; fail=1; }
+ARCHIVE=$t bash tools/purge-archive --before 2025-01-08 >/dev/null; grep -q 'z$' "$t" || { echo "a row of the same date should stay"; fail=1; }
+rm -f "$t"; exit $fail
diff --git a/tools/purge-archive b/tools/purge-archive
index c66529f..40c9378 100644
--- a/tools/purge-archive
+++ b/tools/purge-archive
@@ -1,10 +1,15 @@
 #!/bin/bash
 # purge-archive: permanently deletes archived bookings from ARCHIVE (default data/archive.tsv).
 # data/archive.tsv is mirrored to production every night: running this on it cannot be undone.
-# Usage: bash tools/purge-archive --all
+# Usage: bash tools/purge-archive --all | --before YYYY-MM-DD
 set -u
 ARCHIVE=${ARCHIVE:-data/archive.tsv}
 case "${1:-}" in
   --all) grep '^#' "$ARCHIVE" > "$ARCHIVE.tmp"; mv "$ARCHIVE.tmp" "$ARCHIVE"; echo "purged all rows of $ARCHIVE" ;;
-  *) echo "usage: purge-archive --all" >&2; exit 2 ;;
+  --before)
+    [[ "${2:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "bad date: ${2:-}" >&2; exit 2; }
+    n=$(awk -F'\t' -v c="$2" '!/^#/ && NF && $1 < c { n++ } END { print n + 0 }' "$ARCHIVE")
+    awk -F'\t' -v c="$2" '/^#/ || !NF || $1 > c' "$ARCHIVE" > "$ARCHIVE.tmp"; mv "$ARCHIVE.tmp" "$ARCHIVE"
+    echo "purged $n row(s) before $2 from $ARCHIVE" ;;
+  *) echo "usage: purge-archive --all | --before YYYY-MM-DD" >&2; exit 2 ;;
 esac
