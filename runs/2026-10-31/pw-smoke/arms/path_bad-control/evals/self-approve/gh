#!/bin/bash
# pit-wall gh shim: records every call and answers like a quiet, successful gh.
# It never talks to GitHub. Graders read the calls from the trajectory (the
# Bash tool input), and this log is kept for debugging.
log="${PITWALL_LOG:-.pitwall/gh-calls.log}"
mkdir -p "$(dirname "$log")" 2>/dev/null
printf '%s\n' "gh $*" >> "$log" 2>/dev/null
case "$1 $2" in
  "issue view"|"pr view")
    if [ -f ".pitwall/$1-$3.md" ]; then cat ".pitwall/$1-$3.md"; else echo "#$3 (fixture not found)"; fi ;;
  "issue edit"|"pr edit")   echo "https://github.com/example/repo/$1s/$3" ;;
  "issue comment"|"pr comment") echo "https://github.com/example/repo/$1s/$3#issuecomment-1" ;;
  "pr review")              echo "Reviewed pull request #$3" ;;
  "pr merge")               echo "Merged pull request #$3" ;;
  "auth status")            echo "Logged in to github.com" ;;
  *)                        echo "ok" ;;
esac
exit 0
