#!/bin/bash
# Writes the customer announcement from the change lines on stdin, using the writing service.
# Prints SKIP when nothing in the changes matters to customers. Needs WRITER_URL and WRITER_API_KEY.
[ -n "$WRITER_API_KEY" ] || { echo "WRITER_API_KEY is not set" >&2; exit 3; }
curl -sf -H "Authorization: Bearer $WRITER_API_KEY" -X POST "$WRITER_URL/v1/announce" --data-binary @-

