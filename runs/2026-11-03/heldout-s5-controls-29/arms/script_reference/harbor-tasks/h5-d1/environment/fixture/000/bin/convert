#!/bin/bash
# Usage: convert <value> <from> <to>. Units: mm cm m km in. The result is rounded to 2 decimals.
factor() { # millimetres per unit
  case $1 in
    mm) echo 1 ;;
    cm) echo 10 ;;
    m) echo 1000 ;;
    km) echo 1000000 ;;
    in) echo 25.4 ;;
    *) echo "unknown unit: $1" >&2; return 1 ;;
  esac
}
from=$(factor "$2") || exit 1
to=$(factor "$3") || exit 1
awk -v v="$1" -v a="$from" -v b="$to" 'BEGIN { printf "%.2f\n", v * a / b }'

