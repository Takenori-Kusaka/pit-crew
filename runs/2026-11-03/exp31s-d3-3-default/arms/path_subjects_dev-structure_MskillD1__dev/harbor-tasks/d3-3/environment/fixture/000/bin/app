#!/bin/bash
# Entry point: app <command> [args]
ROOT=${APP_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
export APP_ROOT=$ROOT
case "$1" in
  avatar) bash "$ROOT/lib/avatar.sh" "$2" ;;
  appointment) bash "$ROOT/lib/appointment.sh" "$2" ;;
  *) echo "usage: app avatar|appointment <arg>" >&2; exit 2 ;;
esac

