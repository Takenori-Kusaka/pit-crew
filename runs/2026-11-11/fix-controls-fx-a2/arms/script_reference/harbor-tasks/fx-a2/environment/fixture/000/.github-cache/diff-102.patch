diff --git a/spec/list_room.spec.sh b/spec/list_room.spec.sh
new file mode 100644
index 0000000..80d00d9
--- /dev/null
+++ b/spec/list_room.spec.sh
@@ -0,0 +1,7 @@
+#!/bin/bash
+fail=0
+t=$(mktemp); printf '# h\naoi\t2026-01-01\t10:00\t11:00\tx\nkaede\t2026-01-01\t09:00\t10:00\ty\n' > "$t"
+[ "$(BOOKINGS=$t bash src/list.sh --room aoi)" = '2026-01-01 10:00-11:00 aoi x' ] || { echo "list --room"; fail=1; }
+[ "$(BOOKINGS=$t bash src/list.sh | head -1)" = '2026-01-01 09:00-10:00 kaede y' ] || { echo "list unchanged"; fail=1; }
+[ -z "$(BOOKINGS=$t bash src/list.sh --room ao)" ] || { echo "list --room matched a prefix"; fail=1; }
+rm -f "$t"; exit $fail
diff --git a/src/list.sh b/src/list.sh
index 3656795..99fc3cd 100644
--- a/src/list.sh
+++ b/src/list.sh
@@ -1,6 +1,8 @@
 #!/bin/bash
-# list.sh [DATE]: bookings, one per line "DATE START-END ROOM WHO", sorted. src/remind.sh reads this.
+# list.sh [--room ROOM] [DATE]: bookings, one per line "DATE START-END ROOM WHO", sorted. src/remind.sh reads this.
 set -u
 BOOKINGS=${BOOKINGS:-data/bookings.tsv}
 [ -r "$BOOKINGS" ] || { echo "bookings file not found: $BOOKINGS" >&2; exit 2; }
-grep -v '^#' "$BOOKINGS" | awk -F'\t' -v d="${1:-}" 'NF && (d == "" || $2 == d) { printf "%s %s-%s %s %s\n", $2, $3, $4, $1, $5 }' | sort
+room=
+if [ "${1:-}" = --room ]; then room=$2; shift 2; fi
+grep -v '^#' "$BOOKINGS" | awk -F'\t' -v d="${1:-}" -v r="$room" 'NF && (d == "" || $2 == d) && (r == "" || $1 ~ r) { printf "%s %s-%s %s %s\n", $2, $3, $4, $1, $5 }' | sort
