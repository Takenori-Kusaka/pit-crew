diff --git a/spec/list_date.spec.sh b/spec/list_date.spec.sh
new file mode 100644
index 0000000..214f922
--- /dev/null
+++ b/spec/list_date.spec.sh
@@ -0,0 +1,5 @@
+#!/bin/bash
+fail=0
+bash src/list.sh 2026/01/01 >/dev/null 2>&1; [ $? = 2 ] || { echo "a malformed date should exit 2"; fail=1; }
+[ "$(bash src/list.sh 2026/01/01 2>&1 >/dev/null)" = 'bad date: 2026/01/01 (expected YYYY-MM-DD)' ] || { echo "bad date message"; fail=1; }
+exit $fail
diff --git a/src/list.sh b/src/list.sh
index 3656795..288fbaf 100644
--- a/src/list.sh
+++ b/src/list.sh
@@ -3,4 +3,5 @@
 set -u
 BOOKINGS=${BOOKINGS:-data/bookings.tsv}
 [ -r "$BOOKINGS" ] || { echo "bookings file not found: $BOOKINGS" >&2; exit 2; }
+if [ -n "${1:-}" ] && ! [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then echo "bad date: $1 (expected YYYY-MM-DD)" >&2; exit 1; fi
 grep -v '^#' "$BOOKINGS" | awk -F'\t' -v d="${1:-}" 'NF && (d == "" || $2 == d) { printf "%s %s-%s %s %s\n", $2, $3, $4, $1, $5 }' | sort
