diff --git a/spec/usage.spec.sh b/spec/usage.spec.sh
new file mode 100644
index 0000000..d253f2c
--- /dev/null
+++ b/spec/usage.spec.sh
@@ -0,0 +1,6 @@
+#!/bin/bash
+fail=0
+bash src/book.sh aoi 2026-01-05 10:00 >/dev/null 2>&1; [ $? = 2 ] || { echo "book: missing arguments should exit 2"; fail=1; }
+bash src/book.sh aoi 2>&1 >/dev/null | grep -q '^usage: ' || { echo "book: usage goes to stderr"; fail=1; }
+bash src/remind.sh 2>&1 >/dev/null | grep -q '^usage: remind.sh DATE$' || { echo "remind: usage goes to stderr"; fail=1; }
+exit $fail
diff --git a/src/book.sh b/src/book.sh
index a8cd691..dc8701a 100644
--- a/src/book.sh
+++ b/src/book.sh
@@ -3,6 +3,7 @@
 set -u
 . "$(dirname "$0")/lib/slots.sh"
 BOOKINGS=${BOOKINGS:-data/bookings.tsv}
+if [ $# -ne 5 ]; then echo "usage: book ROOM DATE START END WHO" >&2; exit 1; fi
 room=$1 date=$2 start=$3 end=$4 who=$5
 s=$(to_min "$start"); e=$(to_min "$end")
 [ "$s" -lt "$e" ] || { echo "end must be after start" >&2; exit 2; }
diff --git a/src/remind.sh b/src/remind.sh
index d74bf4c..ce40e97 100644
--- a/src/remind.sh
+++ b/src/remind.sh
@@ -1,5 +1,6 @@
 #!/bin/bash
 # remind.sh DATE: one reminder per booking of the day, from the listing.
 set -u
+if [ $# -ne 1 ]; then echo "usage: remind.sh DATE" >&2; exit 1; fi
 out=$(bash "$(dirname "$0")/list.sh" "$@") || exit $?
 [ -z "$out" ] || printf '%s\n' "$out" | while read -r d t r w; do echo "reminder to $w: $r $d $t"; done
