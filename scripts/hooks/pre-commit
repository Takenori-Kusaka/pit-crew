#!/bin/bash
# Secret scan of staged files before every commit (charter: "runs は commit 前に秘密情報を検査する";
# broken twice on 2026-11-03 by committing first and scanning after). Checks staged files for the
# subscription OAuth token (read inside WSL, never printed) and for common secret shapes.
# Installed with: git config core.hooksPath scripts/hooks
set -u
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
list=$(mktemp); printf '%s\n' $files > "$list"
hits=$(xargs -a "$list" grep -lE '(sk-ant-[A-Za-z0-9_-]{20}|ghp_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY)' 2>/dev/null)
if command -v wsl.exe >/dev/null 2>&1; then
  root=$(git rev-parse --show-toplevel)
  wroot=$(wsl.exe wslpath -a "$root" 2>/dev/null | tr -d '\r')
  wlist=$(wsl.exe wslpath -a "$list" 2>/dev/null | tr -d '\r')
  if [ -n "$wroot" ] && [ -n "$wlist" ]; then
    tok=$(MSYS_NO_PATHCONV=1 wsl.exe -- bash -c "cd '$wroot' && [ -s ~/.config/pit-wall/oauth-token ] && xargs -a '$wlist' grep -lF -f ~/.config/pit-wall/oauth-token 2>/dev/null" | tr -d '\r')
    hits="$hits $tok"
  fi
fi
rm -f "$list"
hits=$(echo $hits)
if [ -n "$hits" ]; then
  echo "pre-commit: secret-shaped content in staged files (not committed):"
  echo "$hits" | tr ' ' '\n' | sed 's/^/  /'
  exit 1
fi
exit 0
